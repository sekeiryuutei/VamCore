# ============================================================================
# infrastructure/.env.example
# Copia este archivo a infrastructure/.env y ajusta los valores.
# NUNCA subas infrastructure/.env real a git (ver .gitignore).
# ============================================================================

COMPOSE_PROJECT_NAME=vamcore

# Base de datos
VAMCORE_DB_NAME=vamcore
VAMCORE_DB_USER=vamcore
VAMCORE_DB_PASSWORD=vamcore
VAMCORE_DB_PORT=5432

# Backend
VAMCORE_APP_NAME=vamcore-backend
VAMCORE_SERVER_PORT=8080
VAMCORE_PLATFORM_NAME=VamCore
VAMCORE_COMPANY_NAME=Codevam
VAMCORE_JWT_SECRET=change-this-secret-in-every-environment-please
VAMCORE_JWT_EXPIRATION_MINUTES=60

# Archivos (Files, ver sección 38 del documento de arquitectura)
# El storage-path dentro del contenedor está fijo en /app/storage (montado
# como volumen Docker vamcore_files_data para persistir entre reinicios).
VAMCORE_MAX_FILE_SIZE=10MB

# Frontend
VAMCORE_FRONTEND_PORT=4200
